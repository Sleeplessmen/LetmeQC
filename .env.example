# =============================================================================
# LetmeQC - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# All variables are optional except CVAT_TOKEN for production use
# =============================================================================

# -----------------------------------------------------------------------------
# CVAT Configuration
# -----------------------------------------------------------------------------
CVAT_TOKEN=your_cvat_api_token_here
CVAT_API_URL=https://app.cvat.ai/api
CVAT_ORG_SLUG=your_organization_slug

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# QC Rules Configuration
# -----------------------------------------------------------------------------
# Minimum area for bounding boxes (pixels^2)
MIN_BOX_AREA=100.0

# IOU threshold for detecting overlapping boxes
IOU_THRESHOLD=0.95

# IOU threshold for detecting duplicate boxes
DUPLICATE_IOU_THRESHOLD=0.98

# Minimum number of points for polygons
MIN_POLYGON_POINTS=3

# Maximum aspect ratio for boxes (width/height)
MAX_ASPECT_RATIO=10.0

# Minimum aspect ratio for boxes (width/height)
MIN_ASPECT_RATIO=0.1

# Tolerance for mask validation
MASK_TOLERANCE=2.0

# Tolerance for bounding box validation
BBOX_TOLERANCE=2.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# LOG_LEVEL can be: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Report Configuration
# -----------------------------------------------------------------------------
# Directory to store reports
REPORTS_DIR=reports

# Maximum number of reports to keep
MAX_REPORTS=5

# =============================================================================
# Example for development:
# =============================================================================
# CVAT_TOKEN=abc123def456ghi789
# CVAT_API_URL=https://staging.cvat.ai/api
# CVAT_ORG_SLUG=my-company
# WEBHOOK_SECRET=my-super-secret-webhook-secret
# SERVER_PORT=8080
# MIN_BOX_AREA=50.0
# IOU_THRESHOLD=0.9
# =============================================================================
