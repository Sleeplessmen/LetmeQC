# =============================================================================
# LetmeQC - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# CVAT API Configuration
# -----------------------------------------------------------------------------
CVAT_API_URL=https://app.cvat.ai/api
CVAT_TOKEN=your_cvat_api_token_here
CVAT_ORG_SLUG=your_organization_slug  # Optional, for X-Organization header
CVAT_TIMEOUT=30  # API request timeout in seconds

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=your_webhook_secret_key  # Optional, for request validation

# -----------------------------------------------------------------------------
# Quality Control Configuration
# -----------------------------------------------------------------------------
# Bounding box validation
MIN_BOX_AREA=100.0  # Minimum bounding box area in pixels
MIN_POLYGON_POINTS=3  # Minimum number of polygon points

# Overlap detection
IOU_THRESHOLD=0.95  # IoU threshold for overlap detection
DUPLICATE_IOU_THRESHOLD=0.98  # IoU threshold for duplicate detection

# Aspect ratio validation
MAX_ASPECT_RATIO=10.0  # Maximum aspect ratio (width/height)
MIN_ASPECT_RATIO=0.1  # Minimum aspect ratio (width/height)

# Mask validation
MASK_TOLERANCE=2.0  # Mask tolerance for validation in pixels
BBOX_TOLERANCE=2.0  # Bounding box tolerance in pixels

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOGGING_LEVEL=INFO  # INFO, DEBUG, WARNING, ERROR, CRITICAL
JSON_LOGGING=false  # Enable JSON formatted logging (true/false)
LOG_DIR=logs  # Directory for log files

# -----------------------------------------------------------------------------
# Monitoring Configuration
# -----------------------------------------------------------------------------
# All monitoring is enabled by default
# Set to false to disable specific features
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# Note: All configuration can also be set via environment variables
# =============================================================================
